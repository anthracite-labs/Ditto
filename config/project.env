# Ditto project identity and lifecycle — committed repository state, not secrets.
# Format: exactly one KEY=VALUE assignment per key. No shell expansion, quoting,
# substitutions or inline comments. Scripts parse this file; they NEVER source it.
# See docs/FOUNDATION.md for transitions and the review/admin boundary.

PROJECT_NAME=Ditto
PROJECT_SLUG=ditto

# discovery: product undefined; architecture: product defined, stack being chosen;
# implementation: stack decision recorded, application work may begin after review.
# Ditto is an application repository, not the App-Factory master template.
PROJECT_PHASE=discovery

# 0 keeps the foundation no-stack guard up. 1 requires implementation and an
# existing, accepted application-stack ADR; an environment variable cannot opt out.
ALLOW_APP_STACK=0

# Empty until a real decision exists. Use docs/decisions/NNNN-<title>.md.
# The finished ADR must contain standalone accepted Status and application-stack
# Decision Type metadata; examples, HTML comments and code fences do not count.
STACK_DECISION_ADR=
